# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# venv
.venv/
venv/

# tests / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# datasets (no subir a git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/manifests/*
!data/manifests/.gitkeep

# modelos / pesos / artefactos entrenados
artifacts/*
!artifacts/.gitkeep
*.pt
*.pth
*.onnx
*.joblib
*.ckpt

# reproducibilidad local
requirements.lock

# editores / SO
.vscode/
.idea/
.DS_Store

# Secrets and additional model/cache formats
.env
.env.*
*.pem
*.key
*.safetensors
*.bin
.cache/

# Canonical text-only controlled benchmark; raw/derived images stay ignored.
!data/manifests/benchmark_v1/
data/manifests/benchmark_v1/*
!data/manifests/benchmark_v1/*.json
!data/manifests/benchmark_v1/*.jsonl
